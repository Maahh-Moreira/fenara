generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id String @id @default(uuid()) @db.Uuid
  name String?
  email String @unique
  passwordHash String? @map("password_hash")
  image String?
  createdAt DateTime @default(now()) @map("created_at")
  quizzes Quiz[]
  attempts Attempt[]
  favorites Favorite[]
  badges UserBadge[]
  profile Profile?
  accounts Account[]
  sessions Session[]
  @@map("users")
}
model Account {
  id String @id @default(cuid())
  userId String @map("user_id") @db.Uuid
  type String
  provider String
  providerAccountId String @map("provider_account_id")
  refresh_token String? @db.Text
  access_token String? @db.Text
  expires_at Int?
  token_type String?
  scope String?
  id_token String? @db.Text
  session_state String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@map("auth_accounts")
}
model Session {
  id String @id @default(cuid())
  sessionToken String @unique
  userId String @db.Uuid
  expires DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("auth_sessions")
}
model VerificationToken {
  identifier String
  token String @unique
  expires DateTime
  @@unique([identifier, token])
  @@map("auth_verification_tokens")
}
model Profile {
  userId String @id @db.Uuid
  xp Int @default(0)
  level Int @default(1)
  streak Int @default(0)
  lastPlayed DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("profiles")
}
model Category {
  id String @id @default(uuid()) @db.Uuid
  name String @unique
  slug String @unique
  emoji String
  tone String
  quizzes Quiz[]
  @@map("categories")
}
model Theme {
  id String @id @default(uuid()) @db.Uuid
  name String @unique
  palette Json
  @@map("themes")
}
model QuizTemplate {
  id String @id @default(uuid()) @db.Uuid
  name String @unique
  description String
  category String
  @@map("templates")
}
model Quiz {
  id String @id @default(uuid()) @db.Uuid
  slug String @unique
  title String
  description String @default("")
  difficulty String @default("Fácil")
  cover String @default("space")
  visibility String @default("public")
  status String @default("draft")
  authorId String? @db.Uuid
  categoryId String? @db.Uuid
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  questions Question[]
  attempts Attempt[]
  favorites Favorite[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, visibility])
  @@index([categoryId])
  @@index([authorId])
  @@map("quizzes")
}
model Question {
  id String @id @default(uuid()) @db.Uuid
  quizId String @db.Uuid
  position Int
  kind String @default("multiple_choice")
  text String
  explanation String @default("")
  seconds Int @default(15)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options Option[]
  attemptAnswers AttemptAnswer[]
  @@unique([quizId, position])
  @@map("questions")
}
model Option {
  id String @id @default(uuid()) @db.Uuid
  questionId String @db.Uuid
  position Int
  label String
  correct Boolean @default(false)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  @@unique([questionId, position])
  @@map("options")
}
model Attempt {
  id String @id @default(uuid()) @db.Uuid
  quizId String @db.Uuid
  userId String? @db.Uuid
  guestTokenHash String?
  score Int @default(0)
  combo Int @default(0)
  correctCount Int @default(0)
  finishedAt DateTime?
  startedAt DateTime @default(now())
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  answers AttemptAnswer[]
  @@index([userId, startedAt])
  @@map("attempts")
}
model AttemptAnswer {
  id String @id @default(uuid()) @db.Uuid
  attemptId String @db.Uuid
  questionId String @db.Uuid
  selectedOptionId String? @db.Uuid
  correct Boolean
  points Int
  spentSeconds Int
  createdAt DateTime @default(now())
  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  @@unique([attemptId, questionId])
  @@map("attempt_answers")
}
model Favorite {
  userId String @db.Uuid
  quizId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  @@id([userId, quizId])
  @@map("favorites")
}
model Badge {
  id String @id @default(uuid()) @db.Uuid
  slug String @unique
  name String
  description String
  earned UserBadge[]
  @@map("badges")
}
model UserBadge {
  userId String @db.Uuid
  badgeId String @db.Uuid
  awardedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  @@id([userId, badgeId])
  @@map("user_badges")
}
model LiveSession {
  id String @id @default(uuid()) @db.Uuid
  pin String @unique @db.VarChar(6)
  quizId String @db.Uuid
  hostId String @db.Uuid
  status String @default("waiting")
  createdAt DateTime @default(now())
  players LivePlayer[]
  @@map("live_sessions")
}
model LivePlayer {
  id String @id @default(uuid()) @db.Uuid
  sessionId String @db.Uuid
  nickname String
  score Int @default(0)
  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@map("live_players")
}
